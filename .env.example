# NeuroPay AI environment — copy to .env and fill. Never commit secrets.
PORT=8080
NODE_ENV=production
DATABASE_URL=file:./data/neuropay.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
