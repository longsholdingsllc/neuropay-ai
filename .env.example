# NeuroPay AI environment — copy to .env and fill. Never commit secrets.
PORT=8080
NODE_ENV=production

# Database. Postgres connection string — any hosted Postgres works (e.g. a
# free Supabase project's session-pooler string). No local file or disk:
# the app runs migrations on boot against whatever this points at.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Required in production ---
# Minimum 16 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Initial owner account. Only used the first time the app boots with an empty
# database while SEED_ON_BOOT=true. Change the password before real use.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# Provision the demo tenant + owner on first boot when the DB is empty.
SEED_ON_BOOT=false

# --- Optional ---
# Comma-separated allow-list of browser origins. "*" allows all.
CORS_ORIGIN=*

# Public base URL of the deployment (used for links/redirects).
PUBLIC_APP_URL=http://localhost:8080

# AI estimate boundary. Without a key the app uses a local heuristic model.
# OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Payment boundary. Without a key the app runs in manual payment mode.
# STRIPE_SECRET_KEY=

# Web build-time only (not read by the API at runtime): set VITE_API_URL when
# building packages/web separately if the dashboard is hosted on a different
# origin than the API. Leave unset for the normal single-service deployment —
# the API serves the dashboard same-origin and the app defaults to that.
